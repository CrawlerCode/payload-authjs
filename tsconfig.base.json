{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "target": "ESNext",
    "moduleResolution": "nodenext",
    "module": "ESNext",
    "lib": ["ESNext"],
    "strict": true,
    "sourceMap": true,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
  },
  "exclude": ["${configDir}/dist", "${configDir}/tmp"]
}
